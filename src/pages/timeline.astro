---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";
import primarySources from "../data/primary-sources.json";

const docs = await getCollection('documents');
const yearsCol = await getCollection('years');
const yearTitle: Record<string, string> = {};
for (const y of yearsCol) yearTitle[String(y.data.year)] = y.data.title;
const sourceBySlug = primarySources.bySlug as Record<string, string>;

const cleanTitle = (t: string) => (t || "").replace(/[*_`]/g, "");

const WORDS: Record<string, number> = {
    thirteenth: 13, fourteenth: 14, fifteenth: 15, sixteenth: 16,
    seventeenth: 17, eighteenth: 18, nineteenth: 19, twentieth: 20,
};
// Pull the earliest 4-digit year (1400–1850) and/or century phrase from a string.
// Handles century ranges ("18-19th century", "14th-15th century") as the earliest.
function parseDate(str: string): { year: number | null; century: number | null } {
    if (!str) return { year: null, century: null };
    const years: number[] = [];
    let m: RegExpExecArray | null;
    const yearRe = /\b(1[4-8]\d{2})\b/g;
    while ((m = yearRe.exec(str))) { const y = parseInt(m[1], 10); if (y >= 1400 && y <= 1850) years.push(y); }
    const centuries: number[] = [];
    const rangeRe = /(\d{1,2})(?:th|st|nd|rd)?\s*[-–]\s*(\d{1,2})(?:th|st|nd|rd)?\s*centur/gi;
    while ((m = rangeRe.exec(str))) { const a = parseInt(m[1], 10), b = parseInt(m[2], 10); if (a >= 13 && a <= 20) centuries.push(a); if (b >= 13 && b <= 20) centuries.push(b); }
    const numRe = /(\d{1,2})(?:th|st|nd|rd)[\s-]*centur/gi;
    while ((m = numRe.exec(str))) { const n = parseInt(m[1], 10); if (n >= 13 && n <= 20) centuries.push(n); }
    for (const [w, n] of Object.entries(WORDS)) { if (new RegExp(w + "[\\s-]*centur", "i").test(str)) centuries.push(n); }
    years.forEach((y) => centuries.push(Math.floor((y - 1) / 100) + 1));
    return {
        year: years.length ? Math.min(...years) : null,
        century: centuries.length ? Math.min(...centuries) : null,
    };
}

// A resource's historical date: the primary source's date wins; otherwise the
// title, then the description (many titles carry "18th-Century" / "(1774)").
const dateOf = (d: any): { year: number | null; century: number | null } => {
    const cands = [sourceBySlug[d.data.slug], cleanTitle(d.data.title), d.data.description].filter(Boolean);
    for (const c of cands) {
        const r = parseDate(c as string);
        if (r.century != null) return r;
    }
    return { year: null, century: null };
};

type Entry = { url: string; title: string; author?: string; year: string; sourceYear: number | null; source?: string };
const entryOf = (d: any): Entry => {
    const source = sourceBySlug[d.data.slug];
    return {
        url: `/resources/${d.data.year}/${d.data.slug}`,
        title: cleanTitle(d.data.title),
        author: d.data.author,
        year: String(d.data.year),
        sourceYear: dateOf(d).year,
        source,
    };
};

// ── Axis 1: workshop year ────────────────────────────────────────────────
const byYear = new Map<string, Entry[]>();
for (const d of docs) {
    const y = String(d.data.year);
    if (!byYear.has(y)) byYear.set(y, []);
    byYear.get(y)!.push(entryOf(d));
}
const yearGroups = Array.from(byYear.entries())
    .sort((a, b) => b[0].localeCompare(a[0])) // newest first
    .map(([year, entries]) => ({
        year,
        title: yearTitle[year] || "",
        entries: entries.sort((a, b) => a.title.localeCompare(b.title)),
    }));

// ── Axis 2: historical century (from the primary source's date) ──────────
const ordinal = (c: number) => `${c}th century`;

const byCentury = new Map<number | "none", Entry[]>();
for (const d of docs) {
    const key = dateOf(d).century ?? "none";
    if (!byCentury.has(key)) byCentury.set(key, []);
    byCentury.get(key)!.push(entryOf(d));
}
const byYearThenTitle = (a: Entry, b: Entry) =>
    (a.sourceYear ?? 9999) - (b.sourceYear ?? 9999) || a.title.localeCompare(b.title);
const centuryGroups = Array.from(byCentury.entries())
    .filter(([k]) => k !== "none")
    .sort((a, b) => (a[0] as number) - (b[0] as number)) // earliest first
    .map(([c, entries]) => ({
        label: ordinal(c as number),
        entries: entries.sort(byYearThenTitle),
    }));
const unspecified = byCentury.get("none") || [];
if (unspecified.length) {
    centuryGroups.push({ label: "Period unspecified", entries: unspecified.sort((a, b) => a.title.localeCompare(b.title)) });
}
---

<Layout>
    <Fragment slot="head">
        <title>Timeline | Early Modern Workshop</title>
        <meta name="description" content="Browse the Early Modern Workshop archive chronologically — by workshop year or by the historical century of the sources." />
    </Fragment>

    <section class="py-12 sm:py-16 bg-parchment dark:bg-ink transition-colors">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
            <header class="mb-8">
                <p class="text-[0.72rem] uppercase tracking-[0.22em] text-bronze dark:text-gilt mb-2">Browse by time</p>
                <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink dark:text-paper">Timeline</h1>
            </header>

            <!-- Axis toggle -->
            <div class="inline-flex rounded-sm border border-ink/20 dark:border-paper/25 overflow-hidden mb-3" role="tablist" aria-label="Timeline axis">
                <button id="tab-year" role="tab" aria-selected="true"
                        class="axis-tab px-4 py-2 text-sm font-medium bg-burgundy! text-white!">
                    Workshop year
                </button>
                <button id="tab-century" role="tab" aria-selected="false"
                        class="axis-tab px-4 py-2 text-sm font-medium text-ink dark:text-paper hover:bg-ink/5 dark:hover:bg-paper/10">
                    Historical period
                </button>
            </div>
            <p id="axis-note" class="mb-8 text-sm text-ink/55 dark:text-paper/55">Grouped by the EMW workshop year each resource was published in.</p>

            <!-- Axis 1: workshop year -->
            <div id="axis-year">
                <ol class="relative border-s-2 border-ink/15 dark:border-paper/15 ms-3 space-y-10">
                    {yearGroups.map((g) => (
                        <li class="ms-6">
                            <span class="absolute -start-[9px] mt-1.5 size-4 rounded-full bg-burgundy ring-4 ring-parchment dark:ring-ink"></span>
                            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
                                <h2 class="font-display text-2xl font-semibold text-ink dark:text-paper">{g.year}</h2>
                                {g.title && <span class="text-sm uppercase tracking-[0.15em] text-bronze dark:text-gilt">{g.title}</span>}
                                <span class="text-xs text-ink/40 dark:text-paper/40">{g.entries.length} resources</span>
                            </div>
                            <ul class="space-y-1.5">
                                {g.entries.map((e) => (
                                    <li>
                                        <a href={e.url} class="text-venetian dark:text-venetian-light hover:underline">{e.title}</a>
                                        {e.author && <span class="text-sm text-ink/45 dark:text-paper/45"> · {e.author}</span>}
                                    </li>
                                ))}
                            </ul>
                        </li>
                    ))}
                </ol>
            </div>

            <!-- Axis 2: historical century -->
            <div id="axis-century" class="hidden">
                <ol class="relative border-s-2 border-ink/15 dark:border-paper/15 ms-3 space-y-10">
                    {centuryGroups.map((g) => (
                        <li class="ms-6">
                            <span class="absolute -start-[9px] mt-1.5 size-4 rounded-full bg-burgundy ring-4 ring-parchment dark:ring-ink"></span>
                            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
                                <h2 class="font-display text-2xl font-semibold text-ink dark:text-paper">{g.label}</h2>
                                <span class="text-xs text-ink/40 dark:text-paper/40">{g.entries.length} resources</span>
                            </div>
                            <ul class="space-y-2">
                                {g.entries.map((e) => (
                                    <li>
                                        <div>
                                            <a href={e.url} class="text-venetian dark:text-venetian-light hover:underline">
                                                {e.sourceYear && <span class="text-ink/45 dark:text-paper/45 tabular-nums mr-1.5">{e.sourceYear}</span>}{e.title}
                                            </a>
                                            {e.author && <span class="text-sm text-ink/45 dark:text-paper/45"> · {e.author}</span>}
                                        </div>
                                        {e.source && <p class="text-xs text-ink/45 dark:text-paper/45 truncate">Source: {e.source}</p>}
                                    </li>
                                ))}
                            </ul>
                        </li>
                    ))}
                </ol>
                <p class="mt-8 text-xs text-ink/45 dark:text-paper/45 max-w-2xl">
                    Dated by the primary source’s year where known; a few without a stated date fall back to their title, and any that can’t be dated are grouped under “Period unspecified.”
                </p>
            </div>
        </div>
    </section>

    <script is:inline>
        (function () {
            const tabYear = document.getElementById("tab-year");
            const tabCentury = document.getElementById("tab-century");
            const axisYear = document.getElementById("axis-year");
            const axisCentury = document.getElementById("axis-century");
            const note = document.getElementById("axis-note");
            const NOTES = {
                year: "Grouped by the EMW workshop year each resource was published in.",
                century: "Grouped by the historical century of the primary sources, by their stated date.",
            };
            const active = "bg-burgundy!", activeText = "text-white!";

            function select(which) {
                const isYear = which === "year";
                axisYear.classList.toggle("hidden", !isYear);
                axisCentury.classList.toggle("hidden", isYear);
                tabYear.setAttribute("aria-selected", String(isYear));
                tabCentury.setAttribute("aria-selected", String(!isYear));
                tabYear.classList.toggle(active, isYear);
                tabYear.classList.toggle(activeText, isYear);
                tabCentury.classList.toggle(active, !isYear);
                tabCentury.classList.toggle(activeText, !isYear);
                note.textContent = NOTES[which];
                history.replaceState(null, "", isYear ? location.pathname : "?axis=century");
            }
            tabYear.addEventListener("click", () => select("year"));
            tabCentury.addEventListener("click", () => select("century"));
            if (new URLSearchParams(location.search).get("axis") === "century") select("century");
        })();
    </script>
</Layout>
